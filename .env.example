# MarketPilot AI - Environment Variables Template
# Copy this file to '.env' or '.env.local' and configure as needed.

# 1. Market Data Configuration Mode
# Available modes: 'demo' (default), 'binance', 'twelvedata', 'alphavantage'
# - 'demo' mode works fully offline without any API keys.
# - 'binance' mode retrieves public Spot exchange data (requires VITE_BINANCE_PUBLIC_MODE=true).
VITE_MARKET_DATA_MODE=demo
VITE_ENABLE_DEMO_FEED=true

# 2. Public Binance Market Data Stream (No credentials required)
VITE_BINANCE_PUBLIC_MODE=false

# 3. Third-party Market API Keys (Optional, requires proxy later)
VITE_TWELVEDATA_API_KEY=
VITE_ALPHAVANTAGE_API_KEY=

# 4. Supabase Database Configuration (Client credentials only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 5. Razorpay Payments Integration (Public sandbox key only)
VITE_RAZORPAY_KEY_ID=

# ==============================================================================
# SECURITY NOTES & BEST PRACTICES
# ==============================================================================
# - DO NOT expose production secret keys on the frontend.
# - OpenAI API keys, Supabase service role keys, Razorpay secret keys, 
#   and broker execution credentials must NEVER be placed in client-side env files.
# - To avoid compromise, route any sensitive requests (e.g. OpenAI Vision scans,
#   payment captures, or trade executions) through a secure backend proxy server.
